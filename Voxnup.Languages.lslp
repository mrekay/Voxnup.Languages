ITH":"Это начало твоего чата с @%s","CHAT_ROOM":"Чат-комната","CLAIM_ACCOUNT_REQUIRED":"Ты не можешь выполнить это действие, пока не закрепишь аккаунт за собой.","CLOSE":"Закрыть","COMING_SOON":"Скоро","COMMUNITY_NOT_FOUND":"Сообщества не найдены.","CONFIRM_LOGOUT_ALL_DEVICES":"Точно хочешь выйти со всех остальных устройств?","CONFIRM_LOGOUT_DEVICE":"Точно хочешь выйти с этого устройства?","CONFIRM_REMOVE_AVATAR":"Точно хочешь удалить свой аватар?","CONNECTED":"Подключено","CONNECT_PERM":"Подключаться","CONNECT_PERM_DESC":"Позволяет участникам подключаться к голосовым комнатам и слушать других.","CONTINUOUS":"Непрерывный","COPY_LINK":"Копировать ссылку","COPY_TEXT":"Копировать текст","COVER_PHOTO":"Обложка","CREATE":"Создать","CREATE_EXPRESSIONS_PERM":"Создавать выражения","CREATE_EXPRESSIONS_PERM_DESC":"Позволяет участникам добавлять в канал собственные эмодзи, стикеры и звуки.","CREATE_INVITE_LINK":"Создать ссылку-приглашение","CREATE_INVITE_PERM":"Создавать приглашение","CREATE_INVITE_PERM_DESC":"Позволяет участникам приглашать новых людей в этот канал.","CREATE_NEW_LINK":"Создать новую ссылку","CREATE_PRIVATE_THREADS_PERM":"Создавать личные ветки","CREATE_PRIVATE_THREADS_PERM_DESC":"Позволяет участникам создавать ветки, доступные только по приглашению.","CREATE_PUBLIC_THREADS_PERM":"Создавать открытые ветки","CREATE_PUBLIC_THREADS_PERM_DESC":"Позволяет участникам создавать ветки, видимые всем в комнате.","CURRENT_DEVICE":"Текущее устройство","CURRENT_EMAIL":"Текущая почта","CURRENT_EMOJIS":"Текущие эмодзи","CURRENT_PASSWORD":"Текущий пароль","CURRENT_SOUNDS":"Текущие звуки","CURRENT_STICKERS":"Текущие стикеры","DANGER_ZONE":"Опасная зона","DARK_THEME":"Тёмная тема","DARK_THEME_DESC":"Тёмная тема по умолчанию","DAYS_VALID":"Срок действия (дней)","DEAFEN":"Отключить звук","DEAFEN_MEMBERS_PERM":"Отключать звук участникам","DEAFEN_MEMBERS_PERM_DESC":"Позволяет участникам отключать звук другим участникам в голосовых комнатах.","DELETE":"Удалить","DELETED_SUCCESS":"Удалено.","DELETED_SUCCESSFULLY":"Успешно удалено.","DELETED_USER_HTML":"&lt;span class='text-gray-700 fst-italic'&gt;Удалённый пользователь&lt;/span&gt;","DELETE_ACCOUNT":"Удалить аккаунт","DELETE_ACCOUNT_EMAIL_DESC":"Твой адрес электронной почты может храниться в системе для проверки личности и в связи с юридическими обязательствами. Однако при желании ты можешь снова зарегистрироваться с той же почтой.","DELETE_ACCOUNT_EMAIL_TITLE":"Адрес почты сохраняется, но ты можешь зарегистрироваться снова","DELETE_ACCOUNT_LEGAL_DESC":"Если в твоём аккаунте была обнаружена деятельность, нарушающая законодательство, Voxnup может навсегда заблокировать повторную регистрацию.","DELETE_ACCOUNT_LEGAL_TITLE":"При нарушении закона повторная регистрация невозможна","DELETE_ACCOUNT_MESSAGES_DESC":"Отправленные тобой сообщения не удаляются из истории чата. Их больше нельзя будет связать с твоим аккаунтом, и они будут храниться анонимно.","DELETE_ACCOUNT_MESSAGES_TITLE":"Твои сообщения останутся анонимными","DELETE_ACCOUNT_NO_ACCESS_DESC":"Твои списки друзей, участие в каналах, информация профиля и все личные данные будут удалены навсегда. Это действие нельзя отменить.","DELETE_ACCOUNT_NO_ACCESS_TITLE":"Ты больше никогда не сможешь получить доступ к аккаунту","DELETE_ACCOUNT_PASSWORD_PROMPT":"Введи пароль, чтобы удалить аккаунт. Это действие &lt;strong&gt;нельзя отменить.&lt;/strong&gt;","DELETE_ACCOUNT_PERMANENTLY":"Удалить мой аккаунт навсегда","DELETE_ACCOUNT_PRIVACY_NOTICE":"Чтобы узнать больше о том, как обрабатываются твои данные, ознакомься с нашей &lt;a href=\"https://voxnup.com/privacy\" target=\"_blank\" class=\"text-primary fw-semibold\"&gt;Политикой конфиденциальности&lt;/a&gt;.","DELETE_ACCOUNT_READ_INFO":"Прежде чем продолжить, внимательно прочитай информацию ниже.","DELETE_CHANNEL_CONFIRM":"Точно хочешь удалить этот канал? Это действие нельзя отменить.","DELETE_ERROR":"При удалении произошла ошибка.","DELETE_FAILED":"Не удалось выполнить удаление.","DELETE_ITEM_CONFIRM":"Точно хочешь удалить «%s»?","DELETE_MESSAGE":"Удалить сообщение","DELETE_MESSAGE_CONFIRM":"Точно хочешь удалить это сообщение?","DELETE_SOUND":"Удалить звук","DELETE_SOUND_CONFIRM":"Точно хочешь удалить звук «%s»?","DELETING":"Удаление...","DESC_ACTIVITY_MANAGER":"Управление определениями для обнаружения активности","DESC_ADMIN_CHANNELS":"Панель управления каналами и банами Voxnup","DESC_DEVROOM":"Статистика платформы и состояние системы Voxnup","DESC_SUPPORT":"Центр поддержки Voxnup. Часто задаваемые вопросы, техническая помощь и контактная информация.","DESKTOP_APP_ONLY_FEATURE":"Эта функция доступна только в настольном приложении","DESKTOP_NOTIFICATIONS":"Уведомления на рабочем столе","DESKTOP_NOTIFICATIONS_DESC":"Показывать уведомления на рабочем столе для каждой комнаты и канала","DEVICES":"Устройства","DEVICES_TAB_DESC":"Здесь перечислены устройства, на которых ты используешь Voxnup. Ты можешь выйти из них по одному или сразу со всех.","DEVICES_TAB_DESC_WARNING":"Если на незнакомом устройстве открыта твоя сессия, немедленно заверши её и смени пароль Voxnup.","DEVICE_LOGGED_OUT":"Выход с устройства выполнен.","DISCOVER_COMMUNITIES_HINT":"Открывай для себя сообщества — возможно, ты встретишь их там или найдёшь новых друзей.","DISMISS":"Отмена","DISPLAY_NAME_HINT":"Введи имя, которым ты хочешь, чтобы тебя называли.","DRACULA_THEME":"Тема Dracula","DRACULA_THEME_DESC":"Любимый тёмный режим вампиров","DRAG_AND_DROP":"Перетащи и отпусти","DROP_FILE_HINT":"Перетащи сюда свой файл, и мы поместим его в поле сообщения","EDITED":"(Изменено)","EDITING_MESSAGE":"Редактирование сообщения","EDIT_IMAGE":"Редактировать изображение","EDIT_INVITE_LINK":"Редактировать ссылку-приглашение.","EDIT_MESSAGE":"Редактировать сообщение","EMAIL_CHANGE_VERIFICATION_SENT":"На твой новый адрес почты отправлено письмо для подтверждения.","EMAIL_NOTIFICATIONS":"Уведомления по почте","EMAIL_NOTIFICATIONS_DESC":"Выбери, какие письма ты хочешь получать","EMAIL_SEND_ERROR":"Не удалось отправить пис